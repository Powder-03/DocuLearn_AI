# PostgreSQL Configuration (Neon Cloud)
# Get your DATABASE_URL from: https://console.neon.tech
POSTGRES_USER=admin
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=neondb
POSTGRES_HOST=your-neon-host.aws.neon.tech
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:password@host.aws.neon.tech/database?sslmode=require

# MongoDB Configuration (Atlas Cloud)
# Get your MONGODB_URL from: https://cloud.mongodb.com
MONGO_USER=your_mongo_user
MONGO_PASSWORD=your_mongo_password
MONGO_DB=learning_saas_chats
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Groq API Key
# Get your API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
